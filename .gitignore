# Android TWA. Never commit signing keys, passwords or build output.
android/*
!android/twa-manifest.json
!android/store-listing.md
!android/PLAY_GUIDE.md

# Capacitor app. The native project is committed for reproducibility; only build output and deps are excluded.
android-app/node_modules/
android-app/www/
android-app/android/build/
android-app/android/app/build/
android-app/android/.gradle/
android-app/android/local.properties
android-app/android/keystore.properties
android-app/*.aab
android-app/*.apk
android-app/*.idsig
android-app/*.zip
# iOS generated files and dependencies. The project is committed; Pods and builds are generated in CI.
android-app/ios/App/Pods/
android-app/ios/App/build/
android-app/ios/App/output/
android-app/ios/App/DerivedData/
android-app/ios/App/App/public/
android-app/*.ipa
release/
